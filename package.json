{
	"name": "sk-sesher",
	"version": "0.1.0",
	"description": "Simple password-based session management for SvelteKit personal projects",
	"author": "Neville Brem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nevthereal/sk-sesher.git"
	},
	"homepage": "https://github.com/nevthereal/sk-sesher#readme",
	"bugs": {
		"url": "https://github.com/nevthereal/sk-sesher/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./auth/remote": {
			"types": "./dist/auth.remote.d.ts",
			"svelte": "./dist/auth.remote.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.46.0",
		"@sveltejs/kit": "^2.49.0 || ^3.0.0"
	},
	"dependencies": {
		"valibot": "^1.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"session",
		"authentication",
		"auth",
		"password",
		"remote-functions"
	]
}
